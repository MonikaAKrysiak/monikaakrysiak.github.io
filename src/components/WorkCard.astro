---
const {
	title,
	summary,
	focusAreas,
	href
} = Astro.props;
---

<article class="work-card">
	<h3 class="work-card-title">{title}</h3>

	<p class="work-card-summary">
		{summary}
	</p>

	<div class="work-card-footer">
		<ul class="work-card-focusAreas">
			{focusAreas.map((focusArea) => (
				<li>{focusArea}</li>
			))}
		</ul>

		<a class="work-card-href" href={href}>
			Read case study
		</a>
	</div>
</article>

<style>
	.work-card {
	display: flex;
	flex-direction: column;
	width: 100%;

	padding: var(--space-lg);
	border: 1px solid var(--color-border);
	border-radius: 0.75rem;
	background-color: var(--color-surface);

	transition:
	    background-color 0.2s ease,
	    border-color 0.2s ease,
	    transform 0.2s ease;
    }

    .work-card:hover {
	background-color: #313733;
	border-color: var(--color-primary);
	transform: translateY(-0.25rem);
    }

    .work-card:focus-within {
	border-color: var(--color-secondary);
    }

	.work-card-title,
	.work-card-summary,
	.work-card-focusAreas {
		margin: 0;
	}

	.work-card-title {
		margin-bottom: var(--space-sm);
		font-size: var(--font-size-heading);
		line-height: 1.2;
	}

	.work-card-summary {
		margin-bottom: auto;
		line-height: var(--line-height-body);
	}

	.work-card-footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);

		margin-top: var(--space-lg);
	}

	.work-card-focusAreas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs) var(--space-md);

		padding: 0;
		list-style: none;
	}

	.work-card-focusAreas li {
		color: var(--color-primary);
		font-size: 0.9rem;
		font-weight: 500;
	}

	.work-card-href {
		align-self: flex-start;
		color: var(--color-secondary);
		font-weight: 500;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25rem;
	}

	.work-card-href:hover {
		color: var(--color-primary-hover);
	}

	.work-card-href:focus-visible {
		outline: 2px solid var(--color-secondary);
		outline-offset: 0.25rem;
		border-radius: 0.25rem;
	}
</style>