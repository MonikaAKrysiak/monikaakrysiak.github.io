---
import type { ImageMetadata } from "astro:assets";

import type { Language } from "../i18n";

import InteractiveFigure from "./InteractiveFigure.astro";

interface Props {
	id: string;
	lang: Language;

	title: string;
	paragraphs: string[];

	includesTitle: string;
	includes: string[];

	focusAreasTitle: string;
	focusAreas: string[];

	impactTitle: string;
	outcome: string;

	image: ImageMetadata;
	imageAlt: string;
}

const {
	id,
	lang,
	title,
	paragraphs,
	includesTitle,
	includes,
	focusAreasTitle,
	focusAreas,
	impactTitle,
	outcome,
	image,
	imageAlt,
} = Astro.props;
---
<section
	id={id}
	class="documentation-showcase"
	data-language-section
>
	<div class="documentation-showcase-introduction">
		<div class="documentation-showcase-introduction-main">
			<h2 class="documentation-showcase-title">
				{title}
			</h2>

			<div class="documentation-showcase-content">
				{paragraphs.map((paragraph) => (
					<p class="case-study-text">
						{paragraph}
					</p>
				))}
			</div>
		</div>

		<aside class="documentation-showcase-meta">
			<h3 class="documentation-showcase-meta-title">
				{focusAreasTitle}
			</h3>

			<ul class="documentation-showcase-focus-areas">
				{focusAreas.map((focusArea) => (
					<li class="documentation-showcase-focus-area">
						{focusArea}
					</li>
				))}
			</ul>
		</aside>
	</div>

	<InteractiveFigure
		lang={lang}
		src={image}
		alt={imageAlt}
	/>

	<div class="documentation-showcase-details">
		<div class="documentation-showcase-includes">
			<h3 class="documentation-showcase-subtitle">
				{includesTitle}
			</h3>

			<ul class="documentation-showcase-includes-list">
				{includes.map((item) => (
					<li class="documentation-showcase-includes-item">
						{item}
					</li>
				))}
			</ul>
		</div>

		<div class="documentation-showcase-outcome">
			<h3 class="documentation-showcase-subtitle">
				{impactTitle}
			</h3>

			<p class="case-study-text">
				{outcome}
			</p>
		</div>
	</div>
</section>