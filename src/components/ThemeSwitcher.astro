---
import type { Language } from "../i18n";
import { getTranslations } from "../i18n";
import ThemeLight from "../assets/icons/theme-light.svg";
import ThemeDark from "../assets/icons/theme-dark.svg";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<button
	class="theme-switcher"
	type="button"
	aria-label={t.themeSwitcher.switchToLight}
	data-switch-to-light={t.themeSwitcher.switchToLight}
	data-switch-to-dark={t.themeSwitcher.switchToDark}
>
	<ThemeLight
		class="theme-icon theme-icon-light"
		aria-hidden="true"
	/>

	<ThemeDark
		class="theme-icon theme-icon-dark"
		aria-hidden="true"
	/>
</button>

<script>
	const themeSwitcher = document.querySelector(".theme-switcher");

	const themeColorMeta = document.querySelector(
		'meta[name="theme-color"]'
	);

	function updateThemeLabel(theme: string) {
		const label =
			theme === "dark"
				? themeSwitcher?.getAttribute("data-switch-to-light")
				: themeSwitcher?.getAttribute("data-switch-to-dark");

		if (label) {
			themeSwitcher?.setAttribute("aria-label", label);
		}
	}

	function updateTheme(theme: string) {
		document.documentElement.dataset.theme = theme;

		const backgroundColor = getComputedStyle(document.documentElement)
			.getPropertyValue("--color-background")
			.trim();

		themeColorMeta?.setAttribute("content", backgroundColor);

		localStorage.setItem("theme", theme);

		updateThemeLabel(theme);
	}

	const currentTheme = document.documentElement.dataset.theme ?? "dark";

	updateThemeLabel(currentTheme);

	themeSwitcher?.addEventListener("click", () => {
		const activeTheme = document.documentElement.dataset.theme ?? "dark";
		const nextTheme = activeTheme === "dark" ? "light" : "dark";

		updateTheme(nextTheme);
	});
</script>