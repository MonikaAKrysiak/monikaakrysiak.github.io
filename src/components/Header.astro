---
import Navigation from "./Navigation.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

import ToggleMenuIcon from "../assets/icons/toggle-menu.svg";
import ToggleCloseIcon from "../assets/icons/toggle-close.svg";

import type { Language } from "../i18n";
import type { NavigationItem } from "../types/navigation";

interface Props {
	lang: Language;
	navigationItems?: NavigationItem[];
}

const {
	lang,
	navigationItems = [],
} = Astro.props;

const hasNavigation = navigationItems.length > 0;

const navigationLabel =
	lang === "pl"
		? "Nawigacja strony"
		: "Page navigation";
---
<header class="site-header">
	<div class="container">
		<div class="site-header-content">
			<div class="site-header-top">
				<a
					class="site-logo"
					href={`/${lang}/`}
					aria-label="Monika Krysiak – homepage"
				>
					Monika Krysiak
				</a>

				<div class="site-controls">
					<LanguageSwitcher lang={lang} />
					<ThemeSwitcher lang={lang} />

					{
						hasNavigation && (
							<button
								class="navigation-toggle"
								type="button"
								aria-label={lang === "pl" ? "Otwórz menu" : "Open menu"}
								aria-expanded="false"
								aria-controls="primary-navigation"
								data-navigation-toggle
								data-open-label={lang === "pl" ? "Otwórz menu" : "Open menu"}
								data-close-label={lang === "pl" ? "Zamknij menu" : "Close menu"}
							>
								<ToggleMenuIcon
									class="navigation-toggle-icon navigation-toggle-icon-menu"
									aria-hidden="true"
								/>

								<ToggleCloseIcon
									class="navigation-toggle-icon navigation-toggle-icon-close"
									aria-hidden="true"
								/>
							</button>
						)
					}
				</div>
			</div>

			{
				hasNavigation && (
					<Navigation
						items={navigationItems}
						id="primary-navigation"
						ariaLabel={navigationLabel}
					/>
				)
			}
		</div>
	</div>
</header>

<script>
	function updateNavigationToggle(
		navigationToggle: HTMLButtonElement,
		isOpen: boolean,
	) {
		navigationToggle.setAttribute(
			"aria-expanded",
			String(isOpen),
		);

		navigationToggle.setAttribute(
			"aria-label",
			isOpen
				? navigationToggle.dataset.closeLabel ?? "Close menu"
				: navigationToggle.dataset.openLabel ?? "Open menu",
		);
	}

	const navigationToggle = document.querySelector(
		"[data-navigation-toggle]",
	);

	if (navigationToggle instanceof HTMLButtonElement) {
		navigationToggle.addEventListener("click", () => {
			const header = navigationToggle.closest(".site-header");

			if (!(header instanceof HTMLElement)) {
				return;
			}

			const isOpen = header.classList.toggle("navigation-open");

			updateNavigationToggle(navigationToggle, isOpen);
		});
	}

	const navigationLinks = document.querySelectorAll(
		"#primary-navigation a",
	);

	navigationLinks.forEach((navigationLink) => {
		navigationLink.addEventListener("click", () => {
			const header = navigationLink.closest(".site-header");
			const navigationToggle = header?.querySelector(
				"[data-navigation-toggle]",
			);

			if (
				!(header instanceof HTMLElement) ||
				!(navigationToggle instanceof HTMLButtonElement)
			) {
				return;
			}

			header.classList.remove("navigation-open");

			updateNavigationToggle(navigationToggle, false);
		});
	});

	document.addEventListener("click", (event) => {
		const target = event.target;

		if (!(target instanceof Node)) {
			return;
		}

		const header = document.querySelector(".site-header");
		const navigationToggle = document.querySelector(
			"[data-navigation-toggle]",
		);

		if (
			!(header instanceof HTMLElement) ||
			!(navigationToggle instanceof HTMLButtonElement)
		) {
			return;
		}

		if (!header.classList.contains("navigation-open")) {
			return;
		}

		if (header.contains(target)) {
			return;
		}

		header.classList.remove("navigation-open");

		updateNavigationToggle(navigationToggle, false);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") {
			return;
		}

		const header = document.querySelector(".site-header");
		const navigationToggle = document.querySelector(
			"[data-navigation-toggle]",
		);

		if (
			!(header instanceof HTMLElement) ||
			!(navigationToggle instanceof HTMLButtonElement)
		) {
			return;
		}

		if (!header.classList.contains("navigation-open")) {
			return;
		}

		header.classList.remove("navigation-open");

		updateNavigationToggle(navigationToggle, false);

		navigationToggle.focus();
	});
	const navigationItems = document.querySelectorAll(
		'#primary-navigation a[href^="#"]',
	);

	const sections = [...navigationItems]
		.map((navigationItem) => {
			const href = navigationItem.getAttribute("href");

			return href ? document.querySelector(href) : null;
		})
		.filter(
			(section): section is HTMLElement =>
				section instanceof HTMLElement,
		);

	const sectionLinks = document.querySelectorAll<HTMLAnchorElement>(
	'#primary-navigation a[href^="#"]',
);

const observedSections = [...sectionLinks]
	.map((link) => {
		const href = link.getAttribute("href");

		if (!href) {
			return null;
		}

		const section = document.querySelector(href);

		return section instanceof HTMLElement
			? { link, section }
			: null;
	})
	.filter(
		(
			item,
		): item is {
			link: HTMLAnchorElement;
			section: HTMLElement;
		} => item !== null,
	);

function setActiveNavigationLink(activeSectionId: string) {
	sectionLinks.forEach((link) => {
		const isActive = link.getAttribute("href") === `#${activeSectionId}`;

		if (isActive) {
			link.setAttribute("aria-current", "location");
		} else {
			link.removeAttribute("aria-current");
		}
	});
}

const sectionObserver = new IntersectionObserver(
	(entries) => {
		const visibleEntry = entries
			.filter((entry) => entry.isIntersecting)
			.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

		if (!(visibleEntry?.target instanceof HTMLElement)) {
			return;
		}

		setActiveNavigationLink(visibleEntry.target.id);
	},
	{
		rootMargin: "-25% 0px -60% 0px",
		threshold: [0, 0.25, 0.5, 0.75, 1],
	},
);

observedSections.forEach(({ section }) => {
	sectionObserver.observe(section);
});
</script>