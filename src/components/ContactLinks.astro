---
import GitHubIcon from "../assets/icons/github.svg";
import LinkedInIcon from "../assets/icons/linkedin.svg";
import MailIcon from "../assets/icons/mail.svg";
import {
	getTranslations,
	type Language,
} from "../i18n";

interface Props {
	lang: Language;
	variant?: "default" | "footer";
}

const {
	lang,
	variant = "default",
} = Astro.props;

const t = getTranslations(lang);
---

<address
	class:list={[
		"contact-details",
		{ "contact-details-footer": variant === "footer" },
	]}
>
	<ul class="contact-list">
		<li>
			<a href="mailto:monika.a.krysiak@gmail.com">
				<MailIcon
					class="contact-icon"
					aria-hidden="true"
				/>
				<span>monika.a.krysiak@gmail.com</span>
			</a>
		</li>

		<li>
			<a
				href="https://www.linkedin.com/in/monika-krysiak"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={t.accessibility.externalProfile("LinkedIn")}
			>
				<LinkedInIcon
					class="contact-icon"
					aria-hidden="true"
				/>
				<span>LinkedIn</span>
			</a>
		</li>

		<li>
			<a
				href="https://github.com/MonikaAKrysiak"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={t.accessibility.externalProfile("GitHub")}
			>
				<GitHubIcon
					class="contact-icon"
					aria-hidden="true"
				/>
				<span>GitHub</span>
			</a>
		</li>
	</ul>
</address>