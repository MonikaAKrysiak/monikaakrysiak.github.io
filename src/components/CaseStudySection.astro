---
interface Props {
	id: string;
	title: string;
}

const {
	id,
	title,
} = Astro.props;
---

<section
	id={id}
	class="case-study-section"
	aria-labelledby={`${id}-heading`}
	data-language-section
>
	<h2
		id={`${id}-heading`}
		class="case-study-section-title"
	>
		{title}
	</h2>

	<div class="case-study-section-content">
		<slot />
	</div>
</section>