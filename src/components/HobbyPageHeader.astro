---
interface Props {
	id?: string;
	title: string;
	introduction: string[];
}

const {
	id,
	title,
	introduction,
} = Astro.props;
---

<header
	id={id}
	class="hobby-page-header"
>
	<h1 class="hobby-page-title">
		{title}
	</h1>

	<div class="hobby-page-introduction">
		{
			introduction.map((paragraph) => (
				<p>{paragraph}</p>
			))
		}
	</div>
</header>
<style>
	.hobby-page-header {
		scroll-margin-top: 7rem;
	}

	.hobby-page-title {
		margin: 0 0 var(--space-lg);
	}
</style>