---
interface Props {
	title: string;
	summary: string;
}

const {
	title,
	summary,
} = Astro.props;
---

<header class="case-study-header">
	<div class="case-study-header-content">
		<h1 class="case-study-title">{title}</h1>

		<p class="case-study-summary">{summary}</p>
	</div>
</header>

<style>
	.case-study-header {
		display: grid;
		gap: var(--space-xl);
	}

	.case-study-header-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
</style>