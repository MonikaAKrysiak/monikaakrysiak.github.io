---
import WorkCard from "./WorkCard.astro";

import { getTranslations, type Language } from "../i18n";
import { getWork } from "../data/work";
import { formatTypography } from "../utils/typography";

interface Props {
	lang: Language;
}

const { lang }: Props = Astro.props;

const t = getTranslations(lang);
const work = getWork(lang);
---

<section
	id="work"
	class="section"
	aria-labelledby="work-heading"
	data-language-section
>
	<div class="container">
		<h2
			id="work-heading"
			class="section-heading"
		>
			{t.navigation.work}
		</h2>

		<ul class="work-list">
			{work.map((workItem) => (
				<li>
					<WorkCard
						title={formatTypography(workItem.title, lang)}
						summary={formatTypography(workItem.summary, lang)}
						focusAreas={workItem.focusAreas}
						href={`/${lang}${workItem.href}`}
						linkLabel={t.selectedWork.readCaseStudy}
						linkAriaLabel={`${t.selectedWork.readCaseStudy}: ${workItem.title}`}
					/>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.work-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);

		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work-list > li {
		display: flex;
	}

	@media (min-width: 640px) {
		.work-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>