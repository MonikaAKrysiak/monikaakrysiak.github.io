---
import WorkCard from "./WorkCard.astro";

import { getTranslations, type Language } from "../i18n";
import { getWork } from "../data/work";

interface Props {
	lang: Language;
}

const { lang }: Props = Astro.props;

const t = getTranslations(lang);
const work = getWork(lang);
---

<section id="work" class="section">
	<div class="container">
		<h2 class="section-heading">
			{t.navigation.work}
		</h2>

		<ul class="work-list">
			{work.map((workItem) => (
				<li>
					<WorkCard
						title={workItem.title}
						summary={workItem.summary}
						focusAreas={workItem.focusAreas}
						href={workItem.href}
						linkLabel={t.selectedWork.readCaseStudy}
						linkAriaLabel={`${t.selectedWork.readCaseStudy}: ${workItem.title}`}
					/>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.work-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);

		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work-list > li {
		display: flex;
	}

	@media (min-width: 640px) {
		.work-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>