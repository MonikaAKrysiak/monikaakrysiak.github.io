---
import {
	getTranslations,
	type Language,
} from "../i18n";

interface Props {
	lang: Language;
	href?: string;
	label?: string;
}

const {
	lang,
	href = `/${lang}/#work`,
	label,
} = Astro.props;

const t = getTranslations(lang);
---

<a class="case-study-back-link" href={href}>
	<span aria-hidden="true">←</span>
	<span>{label ?? t.backLink.toSelectedWork}</span>
</a>