---
interface Props {
	title: string;
}

const { title }: Props = Astro.props;
---

<article class="knowledge-practice-card">
	<h3 class="knowledge-practice-card-title">
		{title}
	</h3>

	<div class="knowledge-practice-card-content">
		<slot />
	</div>
</article>

<style>
    .knowledge-practice-card {
        padding:
            var(--space-md)
            var(--space-md)
            var(--space-md);

        border: 1px solid var(--color-border);
        border-radius: 0.75rem;

        background: var(--color-surface);
    }

    .knowledge-practice-card-title {
        margin: 0 0 var(--space-sm);

        font-size: var(--font-size-heading);
        line-height: 1.2;
    }

    .knowledge-practice-card-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }   
</style>