---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	summary: string;
	paragraphs: string[];
	image: ImageMetadata;
	imageAlt: string;
	readLabel: string;
	hideLabel: string;
	imagePosition?: string;
}

const {
	title,
	summary,
	paragraphs,
	image,
	imageAlt,
	readLabel,
	hideLabel,
	imagePosition = "center",
} = Astro.props;
---

<article class="hobby-story-card">
	<Image
		class="hobby-story-card-image"
		src={image}
		alt={imageAlt}
		width={320}
		height={220}
		style={`object-position: ${imagePosition};`}
	/>

	<div class="hobby-story-card-body">
		<h3 class="hobby-story-card-title">
			{title}
		</h3>

		<p class="hobby-story-card-summary">
			{summary}
		</p>

		<details
			class="hobby-story-card-details"
			name="tabletop-stories"
		>
			<summary class="hobby-story-card-toggle">
				<span class="hobby-story-card-toggle-open">
					{readLabel}
				</span>

				<span class="hobby-story-card-toggle-close">
					{hideLabel}
				</span>

				<span
					class="hobby-story-card-arrow"
					aria-hidden="true"
				>
					↓
				</span>
			</summary>

			<div class="hobby-story-card-content">
				{
					paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>
		</details>
	</div>
</article>

<style>
	.hobby-story-card {
		display: grid;
		gap: var(--space-lg);
		padding: var(--space-lg);
		scroll-margin-top: calc(var(--header-height) + var(--space-lg));

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.hobby-story-card:has(.hobby-story-card-details[open]) {
		background-color: var(--color-surface-hover);
		border-color: var(--color-accent-games);
	}

	.hobby-story-card-image {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		border-radius: var(--space-xs);
	}

	.hobby-story-card-body {
		min-width: 0;
	}

	.hobby-story-card-title {
		margin: 0 0 var(--space-sm);
	}

	.hobby-story-card-summary {
		margin: 0;
	}

	.hobby-story-card-details {
		margin-top: var(--space-md);
	}

	.hobby-story-card-toggle {
		display: inline-flex;
		align-items: center;

		font-weight: 600;
		color: var(--color-accent-games);

		cursor: pointer;
		user-select: none;
	}

	.hobby-story-card-toggle::-webkit-details-marker {
		display: none;
	}

	.hobby-story-card-toggle::marker {
		content: "";
	}

	.hobby-story-card-content {
		display: grid;
		gap: var(--space-md);
		margin-top: var(--space-lg);
	}

	.hobby-story-card-content p {
		margin: 0;
	}

	.hobby-story-card:hover {
		border-color: var(--color-accent-games);
	}

	.hobby-story-card-arrow {
		display: inline-block;
		margin-left: var(--space-xs);

		transition: transform .2s ease;
	}

	.hobby-story-card-details[open] .hobby-story-card-arrow {
		transform: rotate(180deg);
	}

	.hobby-story-card-toggle-close {
		display: none;
	}

	.hobby-story-card-details[open] .hobby-story-card-toggle-open {
		display: none;
	}

	.hobby-story-card-details[open] .hobby-story-card-toggle-close {
		display: inline;
	}

	:global(html[data-theme="light"]) .hobby-story-card-toggle {
		color: #6553B3;
	}

	@media (min-width: 48rem) {
		.hobby-story-card {
			grid-template-columns: 13rem 1fr;
			align-items: start;
		}

		.hobby-story-card-image {
			height: 12rem;
		}
	}
</style>

<script>
	const storyCards = document.querySelectorAll(".hobby-story-card");

	storyCards.forEach((card) => {
		const details = card.querySelector(".hobby-story-card-details");

		if (!(details instanceof HTMLDetailsElement)) {
			return;
		}

		details.addEventListener("toggle", () => {
			if (!details.open) {
				return;
			}

			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					card.scrollIntoView({
						block: "start",
						behavior: "smooth",
					});
				});
			});
		});
	});
</script>