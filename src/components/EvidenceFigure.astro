---
import type { ImageMetadata } from "astro:assets";
import type { Language } from "../i18n";

import InteractiveFigure from "./InteractiveFigure.astro";

interface Props {
	lang: Language;
	src: ImageMetadata;
	alt: string;
	caption: string;
}

const {
	lang,
	src,
	alt,
	caption,
} = Astro.props;
---

<div class="evidence-figure">
	<InteractiveFigure
		lang={lang}
		src={src}
		alt={alt}
		caption={caption}
	/>
</div>

<style>
	.evidence-figure :global(.interactive-figure) {
		margin: 0;
	}

	.evidence-figure :global(.interactive-figure-caption) {
		margin-top: var(--space-xs);

		color: var(--color-text-muted);
		text-align: center;
	}
</style>