---
import { Image } from "astro:assets";
import type { Language } from "../i18n";

import FlagEn from "../assets/icons/flag-en.svg";
import FlagPl from "../assets/icons/flag-pl.svg";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const currentPath = Astro.url.pathname;
const pathWithoutLanguage = currentPath.replace(/^\/(en|pl)/, "");

const enHref = `/en${pathWithoutLanguage}`;
const plHref = `/pl${pathWithoutLanguage}`;
---

<nav class="language-switcher" aria-label="Language">
	<a
		class:list={[
			"language-option",
			{ "language-option-active": lang === "en" },
		]}
		href={enHref}
		aria-current={lang === "en" ? "page" : undefined}
		data-language-link
	>
		<Image
			src={FlagEn}
			alt=""
			aria-hidden="true"
			class="language-flag"
		/>

		<span>EN</span>
	</a>

	<span class="language-divider" aria-hidden="true">|</span>

	<a
		class:list={[
			"language-option",
			{ "language-option-active": lang === "pl" },
		]}
		href={plHref}
		aria-current={lang === "pl" ? "page" : undefined}
		data-language-link
	>
		<Image
			src={FlagPl}
			alt=""
			aria-hidden="true"
			class="language-flag"
		/>

		<span>PL</span>
	</a>
</nav>

<script>
	function getCurrentSection() {
		const sections = document.querySelectorAll<HTMLElement>(
			"[data-language-section]"
		);

		const viewportMarker = window.innerHeight / 2;

		for (const section of sections) {
			const rect = section.getBoundingClientRect();

			if (
				rect.top <= viewportMarker &&
				rect.bottom > viewportMarker
			) {
				return section.id;
			}
		}

		return "";
	}

	document
		.querySelectorAll<HTMLAnchorElement>("[data-language-link]")
		.forEach((link) => {
			link.addEventListener("click", () => {
				const section = getCurrentSection();

				if (!section) return;

				const href = link.getAttribute("href");

				if (!href) return;

				link.href = `${href}#${section}`;
			});
		});
</script>