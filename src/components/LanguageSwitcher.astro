---
import { Image } from "astro:assets";
import { getTranslations, type Language } from "../i18n";

import FlagEn from "../assets/icons/flag-en.svg";
import FlagPl from "../assets/icons/flag-pl.svg";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const currentPath = Astro.url.pathname;
const pathWithoutLanguage = currentPath.replace(/^\/(en|pl)/, "");

const enHref = `/en${pathWithoutLanguage}`;
const plHref = `/pl${pathWithoutLanguage}`;
---

<nav class="language-switcher" aria-label={t.accessibility.languageSwitcher}>
	<a
		class:list={[
			"language-option",
			{ "language-option-active": lang === "en" },
		]}
		href={enHref}
		aria-current={lang === "en" ? "page" : undefined}
		data-language-link
	>
		<Image
			src={FlagEn}
			alt=""
			aria-hidden="true"
			class="language-flag"
		/>

		<span>EN</span>
	</a>

	<span class="language-divider" aria-hidden="true">|</span>

	<a
		class:list={[
			"language-option",
			{ "language-option-active": lang === "pl" },
		]}
		href={plHref}
		aria-current={lang === "pl" ? "page" : undefined}
		data-language-link
	>
		<Image
			src={FlagPl}
			alt=""
			aria-hidden="true"
			class="language-flag"
		/>

		<span>PL</span>
	</a>
</nav>

<script>
	const focusStorageKey = "restore-language-switcher-focus";

	function getCurrentSection() {
		const sections = document.querySelectorAll<HTMLElement>(
			"[data-language-section]"
		);

		const header = document.querySelector<HTMLElement>(".site-header");
		const headerHeight = header?.getBoundingClientRect().height ?? 0;

		let currentSection = "";
		let smallestDistance = Number.POSITIVE_INFINITY;

		for (const section of sections) {
			const rect = section.getBoundingClientRect();

			const distanceFromHeader = Math.abs(
				rect.top - headerHeight
			);

			if (
				rect.bottom > headerHeight &&
				distanceFromHeader < smallestDistance
			) {
				currentSection = section.id;
				smallestDistance = distanceFromHeader;
			}
		}

		return currentSection;
	}

	function restoreLanguageSwitcherFocus() {
		const shouldRestoreFocus =
			sessionStorage.getItem(focusStorageKey) === "true";

		if (!shouldRestoreFocus) return;

		sessionStorage.removeItem(focusStorageKey);

		const activeLanguageLink =
			document.querySelector<HTMLAnchorElement>(
				"[data-language-link][aria-current='page']"
			);

		requestAnimationFrame(() => {
			activeLanguageLink?.focus({ preventScroll: true });
		});
	}

	document
		.querySelectorAll<HTMLAnchorElement>("[data-language-link]")
		.forEach((link) => {
			link.addEventListener("click", (event) => {
				if (
					event.defaultPrevented ||
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey
				) {
					return;
				}

				sessionStorage.setItem(focusStorageKey, "true");

				const section = getCurrentSection();

				if (!section) return;

				const url = new URL(link.href);

				url.hash = section;
				link.href = url.toString();
			});
		});

	restoreLanguageSwitcherFocus();
</script>