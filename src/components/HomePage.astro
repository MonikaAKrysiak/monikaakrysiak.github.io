---
import { Image } from "astro:assets";

import SelectedWork from "./SelectedWork.astro";
import Contact from "./Contact.astro";

import portrait from "../assets/monika-krysiak-portrait.png";

import { getTranslations, type Language } from "../i18n";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<main id="main-content" tabindex="-1">
	<section class="hero section">
		<div class="hero-content container">
			<div class="hero-copy">
				<h1 class="hero-title">Monika Krysiak</h1>

				<p class="hero-role">
					{t.hero.role}
				</p>

				<p class="hero-statement">
					{t.hero.statementFirstLine}

					{"statementSecondLine" in t.hero && (
						<>
							<br />
							{t.hero.statementSecondLine}
						</>
					)}
				</p>
			</div>

			<Image
				src={portrait}
				alt="Portrait of Monika Krysiak"
				class="hero-portrait"
			/>

			<div class="hero-actions">
				<a
					class="button button-primary"
					href="/cv/monika-krysiak-cv.pdf"
					target="_blank"
					rel="noopener noreferrer"
				>
					{t.hero.viewCv}
				</a>

				<a class="button button-secondary" href="#contact">
					{t.hero.contact}
				</a>
			</div>
		</div>
	</section>

	<section
		id="about"
		class="about section"
		aria-labelledby="about-heading"
		data-language-section
	>
		<div class="container">
			<div class="content-width">
				<h2 id="about-heading" class="section-heading">
					{t.about.title}
				</h2>

				{t.about.paragraphs.map((paragraph) => (
					<p class="section-text">
						{paragraph}
					</p>
				))}
			</div>
		</div>
	</section>

	<SelectedWork lang={lang} />
	<Contact lang={lang} />
</main>