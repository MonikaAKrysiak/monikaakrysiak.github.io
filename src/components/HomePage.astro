---
import { Image } from "astro:assets";
import { formatTypography } from "../utils/typography";

import SelectedWork from "./SelectedWork.astro";
import Contact from "./Contact.astro";
import Hobbies from "./Hobbies.astro";
import InteractiveFigure from "./InteractiveFigure.astro";

import portrait from "../assets/monika-krysiak-portrait.png";
import gallupEn from "../assets/gallup-cliftonstrengths-en.png";
import gallupPl from "../assets/gallup-cliftonstrengths-pl.png";

import { getTranslations, type Language } from "../i18n";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const gallupImage = lang === "pl" ? gallupPl : gallupEn;

---

<main id="main-content" tabindex="-1">
	<section
		id="hero"
		class="hero section"
	>
		<div class="hero-content container">
			<div class="hero-copy">
				<h1 class="hero-title">Monika Krysiak</h1>

				<p class="hero-role">
					{formatTypography(t.hero.role, lang)}
				</p>

				<p class="hero-statement">
					{formatTypography(t.hero.statementFirstLine, lang)}

					{"statementSecondLine" in t.hero && (
						<>
							<br />
							{formatTypography(t.hero.statementSecondLine, lang)}
						</>
					)}
				</p>
			</div>

			<Image
				src={portrait}
				alt={
					lang === "pl"
						? "Portret Moniki Krysiak"
						: "Portrait of Monika Krysiak"
				}
				class="hero-portrait"
			/>

			<div class="hero-actions">
				<a
					class="button button-primary"
					href="/cv/monika-krysiak-cv.pdf"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={t.accessibility.externalLink(t.hero.viewCv)}
				>
					{t.hero.viewCv}
				</a>

				<a class="button button-secondary" href="#contact">
					{t.hero.contact}
				</a>
			</div>
		</div>
	</section>

	<section
		id="about"
		class="about section"
		aria-labelledby="about-heading"
		data-language-section
	>
		<div class="container">
			<div class="content-width">
				<h2 id="about-heading" class="section-heading">
					{t.about.title}
				</h2>

				{t.about.paragraphs.map((paragraph) => (
					<p class="section-text">
						{formatTypography(paragraph, lang)}
					</p>
				))}

				<div class="about-work-style">
					<div class="about-work-style-copy">
						<h3>{t.about.workStyleTitle}</h3>

						{t.about.workStyleText.map((paragraph) => (
							<p class="section-text">
								{formatTypography(paragraph, lang)}
							</p>
						))}
					</div>

					<InteractiveFigure
						lang={lang}
						src={gallupImage}
						alt={
							lang === "pl"
								? "Gallup CliftonStrengths Top 5: Indywidualizacja, Uczenie się, Analityk, Naprawianie i Aktywator"
								: "Gallup CliftonStrengths Top 5: Individualization, Learner, Analytical, Restorative and Activator"
						}
						className="about-work-style-image"
					/>
				</div>
			</div>
		</div>
	</section>

	<SelectedWork lang={lang} />

	<Hobbies lang={lang} />

	<Contact lang={lang} />
</main>