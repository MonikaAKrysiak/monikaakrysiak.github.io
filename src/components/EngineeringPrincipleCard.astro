---
interface Props {
	title: string;
	icon?: any;
}

const {
	title,
	icon: Icon,
} = Astro.props;
---

<article class="engineering-principle-card">
	<div class="engineering-principle-card-heading">
		{
			Icon && (
				<Icon
					class="engineering-principle-card-icon"
					aria-hidden="true"
				/>
			)
		}

		<h3 class="engineering-principle-card-title">
			{title}
		</h3>
	</div>

	<div class="engineering-principle-card-content">
		<slot />
	</div>
</article>

<style>
	.engineering-principle-card {
		padding: var(--space-xl);
		margin-top: var(--space-lg);

		background-color: var(--color-surface-hover);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.engineering-principle-card-heading {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-bottom: var(--space-md);
	}

	.engineering-principle-card-icon {
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-secondary);
	}

	.engineering-principle-card-title {
		margin: 0;
	}

	.engineering-principle-card-content :global(.case-study-text) {
		margin: 0;
	}
</style>