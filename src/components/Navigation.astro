---
import type { NavigationItem } from "../types/navigation";

interface Props {
	items: NavigationItem[];
	id?: string;
	ariaLabel: string;
}

const {
	items,
	id,
	ariaLabel,
} = Astro.props;
---

<nav
	id={id}
	class="site-navigation"
	aria-label={ariaLabel}
>
	<ul
		class:list={[
			"site-navigation-list",
			{ "site-navigation-list-multicolumn": items.length > 3 },
		]}
	>
		{items.map((item) => (
			<li>
				<a href={item.href}>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>