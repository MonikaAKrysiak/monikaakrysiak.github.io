---
import CaseStudyNavigation from "./CaseStudyNavigation.astro";

import type { Language } from "../i18n";

interface NavigationTarget {
	label: string;
	href: string;
}

interface Props {
	lang: Language;
	previous?: NavigationTarget;
	next?: NavigationTarget;
	allHobbiesHref: string;
	allHobbiesLabel: string;
}

const {
	lang,
	previous,
	next,
	allHobbiesHref,
	allHobbiesLabel,
} = Astro.props;
---

<div class="hobby-page-navigation">
	<CaseStudyNavigation
		lang={lang}
		previous={previous}
		next={next}
		allWork={{
			label: allHobbiesLabel,
			href: allHobbiesHref,
		}}
	/>
</div>

<style>
	.hobby-page-navigation {
		margin-top: var(--space-xl);
		padding-top: var(--space-xl);
		border-top: 1px solid var(--color-border);
	}
</style>