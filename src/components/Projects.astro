---
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="section">
	<div class="container">
		<h2 class="section-heading">Projects</h2>

		<ul class="project-list">
			<li>
				<ProjectCard
					title="Portfolio Website"
					description="A personal portfolio built with Astro, HTML and CSS."
					technologies={[
						"Astro",
						"HTML",
						"CSS",
						"Accessibility",
						"Security"
					]}
					link="/"
				/>
			</li>

			<li>
				<ProjectCard
					title="Security Checklist"
					description="Practical application security guides based on OWASP ASVS."
					technologies={["Markdown", "GitHub", "OWASP"]}
					link="/"
				/>
			</li>
		</ul>
	</div>
</section>

<style>
	.project-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);

		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-list > li {
		display: flex;
	}

	@media (min-width: 640px) {
		.project-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>