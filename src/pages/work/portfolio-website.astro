---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CaseStudyHeader from '../../components/CaseStudyHeader.astro';
import CaseStudySection from '../../components/CaseStudySection.astro';
import CaseStudyFigure from '../../components/CaseStudyFigure.astro';

import githubIcon from '../../assets/icons/github.svg';
import portfolioHomepage from '../../assets/case-studies/portfolio-homepage.png';
---

<Layout>
	<main>
		<section class="case-study section">
			<div class="container">
				<BackLink />

				<CaseStudyHeader
					title="Portfolio Website"
					summary="A personal portfolio and long-term learning project exploring modern frontend development through quality, accessibility and security."
					focusAreas={[
						'Astro',
						'HTML',
						'CSS',
						'Accessibility',
						'Security',
					]}
					action={{
						label: 'View source code',
						href: 'https://github.com/MonikaAKrysiak/monikakrysiak.github.io',
						icon: githubIcon,
					}}
				/>

				<CaseStudySection
					title="Overview"
					id="overview"
				>
					<p class="case-study-text">
						This portfolio is more than a place to showcase my work.
					</p>

					<p class="case-study-text">
						It is a long-term learning project where I explore modern frontend
						development while applying the same quality, accessibility and security
						mindset that guides my everyday QA work.
					</p>

					<p class="case-study-text">
						Throughout my career, I usually joined projects that were already in
						progress. This project gives me the opportunity to make architectural
						decisions myself and understand how those decisions shape software from
						its very first commit.
					</p>
				</CaseStudySection>

				<CaseStudyFigure
					src={portfolioHomepage}
					alt="Homepage of the portfolio website showing the hero section, selected work and contact section"
					caption="Current version of the portfolio homepage."
				/>
			</div>
		</section>
	</main>
</Layout>