---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <main>

    <section class="hero">
      <div class="hero-content">

      <h1 class="hero-title">Monika Krysiak</h1>

      <p class="hero-role">
        QA Engineer focused on Application Security.
      </p>

      <p class="hero-statement">
       For me, good software isn’t just functional.
       <br />
       It should also be secure.
      </p>

      <div class="hero-actions">
       <a class="button button-primary" href="/cv">View CV</a>
       <a class="button button-secondary" href="/contact">Contact</a>
      </div>

    </div>
  </section>

  </main>

</Layout>