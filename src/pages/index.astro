<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />

		<style is:inline>
			html {
				background: #1E2320;
			}

			@media (prefers-color-scheme: light) {
				html {
					background: #F4F1E8;
				}
			}
		</style>

		<script is:inline>
			const language =
				navigator.languages?.[0] ??
				navigator.language ??
				"en";

			const destination = language.toLowerCase().startsWith("pl")
				? "/pl/"
				: "/en/";

			window.location.replace(destination);
		</script>

		<title>Loading…</title>
	</head>
	<body></body>
</html>