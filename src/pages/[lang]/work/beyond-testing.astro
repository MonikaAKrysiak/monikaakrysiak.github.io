---
import type { GetStaticPaths } from "astro";
import type { Language } from "../../../i18n";
import { getBeyondTesting } from "../../../data/case-studies/beyond-testing";
import { getAdjacentWork } from "../../../data/work";
import { formatTypography } from "../../../utils/typography";

import Layout from "../../../layouts/Layout.astro";
import CaseStudyHeader from "../../../components/CaseStudyHeader.astro";
import CaseStudySection from "../../../components/CaseStudySection.astro";
import CaseStudyContent from "../../../components/CaseStudyContent.astro";
import BackLink from "../../../components/BackLink.astro";
import CaseStudyNavigation from "../../../components/CaseStudyNavigation.astro";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } },
		{ params: { lang: "pl" } },
	];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;

const language = lang as Language;
const beyondTesting = getBeyondTesting(language);

const { previous, next } = getAdjacentWork(
	language,
	"/work/beyond-testing",
);
---

<Layout lang={language}>
	<main>
		<section id="case-study-start" class="case-study section">
			<div class="container">
				<BackLink lang={language} />

				<CaseStudyContent>
	<div>
		<CaseStudyHeader
			title={formatTypography(
				beyondTesting.header.title,
				language
			)}
			summary={formatTypography(
				beyondTesting.header.summary,
				language
			)}
		/>

		<CaseStudySection
			id="overview"
			title={formatTypography(
				beyondTesting.overview.title,
				language
			)}
		>
			{beyondTesting.overview.paragraphs.map((paragraph) => (
				<p class="case-study-text">
					{formatTypography(paragraph, language)}
				</p>
			))}
		</CaseStudySection>
	</div>

	<div slot="aside">
		<ul class="case-study-focus-areas">
			{beyondTesting.header.focusAreas.map((focusArea) => (
				<li class="case-study-focus-area">
					{focusArea}
				</li>
			))}
		</ul>
	</div>
</CaseStudyContent>
<CaseStudyNavigation
	previous={
		previous
			? {
					href: `/${language}${previous.href}`,
					label: previous.title,
				}
			: undefined
	}
	next={
		next
			? {
					href: `/${language}${next.href}`,
					label: next.title,
				}
			: undefined
	}
	allWork={{
		href: `/${language}/#work`,
		label:
			language === "pl"
				? "Zobacz wszystkie projekty"
				: "View all selected work",
	}}
/>
			</div>
		</section>
	</main>
</Layout>