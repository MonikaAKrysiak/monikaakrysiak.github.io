---
import type { GetStaticPaths } from "astro";
import type { Language } from "../../../i18n";
import { getKnowledgeSharing } from "../../../data/case-studies/knowledge-sharing";
import { formatTypography } from "../../../utils/typography";

import Layout from "../../../layouts/Layout.astro";
import CaseStudyHeader from "../../../components/CaseStudyHeader.astro";
import CaseStudySection from "../../../components/CaseStudySection.astro";
import BackLink from "../../../components/BackLink.astro";

export const getStaticPaths = (() => {
    return [{ params: { lang: "en" } }, { params: { lang: "pl" } }];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;

const language = lang as Language;

const knowledgeSharing = getKnowledgeSharing(language);
---

<Layout lang={language}>
    <main>
        <section class="case-study section">
            <div class="container">
                <BackLink lang={language} />

                <CaseStudyHeader
                    title={formatTypography(knowledgeSharing.header.title, language)}
                    summary={formatTypography(knowledgeSharing.header.summary, language)}
                    focusAreas={knowledgeSharing.header.focusAreas}
                    action={knowledgeSharing.header.action}
                />

                <CaseStudySection
                    id="overview"
                    title={formatTypography(knowledgeSharing.overview.title, language)}
                >
                    {knowledgeSharing.overview.paragraphs.map((paragraph) => (
                        <p class="case-study-text">
                            {formatTypography(paragraph, language)}
                        </p>
                    ))}
                </CaseStudySection>
            </div>
        </section>
    </main>
</Layout>
