---
import type { GetStaticPaths } from "astro";
import type { NavigationItem } from "../../../types/navigation";
import {
	getTranslations,
	type Language,
} from "../../../i18n";

import { getKnowledgeSharing } from "../../../data/case-studies/knowledge-sharing";
import { getKnowledgeSharingSeo } from "../../../data/seo";
import { getAdjacentWork } from "../../../data/work";
import { formatTypography } from "../../../utils/typography";

import Layout from "../../../layouts/Layout.astro";
import CaseStudyHeader from "../../../components/CaseStudyHeader.astro";
import CaseStudySection from "../../../components/CaseStudySection.astro";
import BackLink from "../../../components/BackLink.astro";
import CaseStudyNavigation from "../../../components/CaseStudyNavigation.astro";
import SectionDivider from "../../../components/SectionDivider.astro";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } },
		{ params: { lang: "pl" } },
	];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;

const language = lang as Language;
const translations = getTranslations(language);

const knowledgeSharing = getKnowledgeSharing(language);

const { previous, next } = getAdjacentWork(
	language,
	"/work/knowledge-sharing",
);

const knowledgeSharingNavigationItems: NavigationItem[] = [
    {
        label: language === "pl" ? "Start" : "Home",
        href: "#case-study-start",
    },
	{
		label:
			language === "pl"
				? "Wprowadzenie"
				: "Overview",
		href: "#overview",
	},
	{
		label:
			language === "pl"
				? "Odbiorcy"
				: "Audiences",
		href: "#audiences",
	},
	{
		label:
			language === "pl"
				? "Przykłady"
				: "Examples",
		href: "#practical-examples",
	},
	{
		label:
			language === "pl"
				? "Wpływ"
				: "Impact",
		href: "#impact",
	},
	{
		label:
			language === "pl"
				? "Wnioski"
				: "Learnings",
		href: "#reflection",
	},
];

const seo = getKnowledgeSharingSeo(language);
---

<Layout
	lang={language}
	navigationItems={knowledgeSharingNavigationItems}
    seo={seo}
    articleStructuredData={{
	type: "TechArticle",
	keywords: knowledgeSharing.header.focusAreas,
}}
>

    <main id="main-content" tabindex="-1">
        <section class="case-study section">
            <div class="container">
                <BackLink lang={language} />

                <CaseStudyHeader
                    lang={language}
                    title={formatTypography(knowledgeSharing.header.title, language)}
                    summary={formatTypography(knowledgeSharing.header.summary, language)}
                    focusAreas={knowledgeSharing.header.focusAreas}
                    action={knowledgeSharing.header.action}
                />

                <CaseStudySection
                    id="overview"
                    title={formatTypography(knowledgeSharing.overview.title, language)}
                >
                    {knowledgeSharing.overview.paragraphs.map((paragraph) => (
                        <p class="case-study-text">
                            {formatTypography(paragraph, language)}
                        </p>
                    ))}
                </CaseStudySection>

                <CaseStudySection
                    id="audiences"
                    title={formatTypography(
                        knowledgeSharing.audiences.title,
                        language,
                    )}
                >
                    <p class="case-study-text">
                        {formatTypography(
                            knowledgeSharing.audiences.introduction,
                            language,
                        )}
                    </p>

                    <div class="knowledge-sharing-audiences">
                        {knowledgeSharing.audiences.items.map((audience) => (
                            <article class="content-card">
                                <h3 class="content-card-title">
                                    {formatTypography(audience.title, language)}
                                </h3>

                                <p class="case-study-text">
                                    {formatTypography(audience.description, language)}
                                </p>
                            </article>
                        ))}
                    </div>
                </CaseStudySection>

                <SectionDivider />

                <CaseStudySection
                    id="practical-examples"
                    title={formatTypography(
                        knowledgeSharing.practicalExamples.title,
                        language,
                    )}
                >
                    <p class="case-study-text">
                        {formatTypography(
                            knowledgeSharing.practicalExamples.introduction,
                            language,
                        )}
                    </p>

                     <div class="knowledge-sharing-examples">
                        {knowledgeSharing.practicalExamples.items.map((example) => (
                            <article class="content-card knowledge-sharing-example">
                                <div class="knowledge-sharing-example-main">
                                    <h3 class="content-card-title">
                                        {formatTypography(example.title, language)}
                                    </h3>

                                    <div class="knowledge-sharing-example-part">
                                        <p class="knowledge-sharing-example-label">
                                            {language === "pl" ? "Dlaczego?" : "Why it was needed"}
                                        </p>

                                        <p class="case-study-text">
                                            {formatTypography(example.context, language)}
                                        </p>
                                    </div>

                                    <div class="knowledge-sharing-example-part">
                                        <p class="knowledge-sharing-example-label">
                                            {language === "pl" ? "Jak?" : "What I created"}
                                        </p>

                                        <p class="case-study-text">
                                            {formatTypography(example.approach, language)}
                                        </p>
                                    </div>

                                    <div class="knowledge-sharing-example-part">
                                        <p class="knowledge-sharing-example-label">
                                            {language === "pl" ? "Efekt" : "How it helped"}
                                        </p>

                                        <p class="case-study-text">
                                            {formatTypography(example.outcome, language)}
                                        </p>
                                    </div>
                                </div>

                                <aside class="knowledge-sharing-example-meta">
                                    <dl class="knowledge-sharing-example-meta-list">
                                        {example.meta.map((item) => (
                                            <div class="knowledge-sharing-example-meta-item">
                                                <dt class="knowledge-sharing-example-meta-label">
                                                    {formatTypography(item.label, language)}
                                                </dt>

                                                <dd class="knowledge-sharing-example-meta-value">
                                                    {formatTypography(item.value, language)}
                                                </dd>
                                            </div>
                                        ))}
                                    </dl>
                                </aside>
                            </article>
                        ))}
                    </div>
                </CaseStudySection>

                <SectionDivider />

                <CaseStudySection
                    id="impact"
                    title={formatTypography(knowledgeSharing.impact.title, language)}
                >
                    <p class="case-study-text">
                        {formatTypography(
                            knowledgeSharing.impact.introduction,
                            language,
                        )}
                    </p>

                    <div class="knowledge-sharing-impact">
                        {knowledgeSharing.impact.items.map((item) => (
                            <article class="knowledge-sharing-impact-item">
                                <div
                                    class="knowledge-sharing-impact-marker"
                                    aria-hidden="true"
                                >
                                    <div class="knowledge-sharing-impact-head">
                                        <span class="knowledge-sharing-impact-dot"></span>
                                        <span class="knowledge-sharing-impact-horizontal"></span>
                                    </div>

                                    <span class="knowledge-sharing-impact-line"></span>
                                </div>

                                <div class="knowledge-sharing-impact-content">
                                    <h3 class="knowledge-sharing-impact-title">
                                        {formatTypography(item.title, language)}
                                    </h3>

                                    <p class="case-study-text">
                                        {formatTypography(item.description, language)}
                                    </p>
                                </div>
                            </article>
                        ))}
                    </div>
                </CaseStudySection>

                <CaseStudySection
                    id="reflection"
                    title={formatTypography(
                        knowledgeSharing.reflection.title,
                        language,
                    )}
                >
                    {knowledgeSharing.reflection.paragraphs.map((paragraph) => (
                        <p class="case-study-text">
                            {formatTypography(paragraph, language)}
                        </p>
                    ))}
                </CaseStudySection>

                <SectionDivider />

                <CaseStudyNavigation
                    lang={language}
                    previous={
                        previous
                            ? {
                                    href: `/${language}${previous.href}`,
                                    label: previous.title,
                                }
                            : undefined
                    }
                    next={
                        next
                            ? {
                                    href: `/${language}${next.href}`,
                                    label: next.title,
                                }
                            : undefined
                    }
                    allWork={{
                        href: `/${language}/#work`,
                        label: translations.caseStudyNavigation.allWork,
                    }}
                />
            </div>
        </section>
    </main>
</Layout>
