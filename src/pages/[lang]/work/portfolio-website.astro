---
import type { GetStaticPaths } from 'astro';
import type { Language } from '../../../i18n';
import { getPortfolioWebsite } from '../../../data/case-studies/portfolio-website';


import Layout from '../../../layouts/Layout.astro';
import BackLink from '../../../components/BackLink.astro';
import CaseStudyHeader from '../../../components/CaseStudyHeader.astro';
import CaseStudySection from '../../../components/CaseStudySection.astro';
import CaseStudyFigure from '../../../components/CaseStudyFigure.astro';

import githubIcon from '../../../assets/icons/github.svg';
import portfolioHomepage from '../../../assets/case-studies/portfolio-homepage.png';

export const getStaticPaths = (() => {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'pl' } },
	];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;

const portfolioWebsite = getPortfolioWebsite(lang as Language);
---

<Layout>
	<main>
		<section class="case-study section">
			<div class="container">
				<BackLink />

				<CaseStudyHeader
					title={portfolioWebsite.header.title}
					summary={portfolioWebsite.header.summary}
					focusAreas={portfolioWebsite.header.focusAreas}
					action={portfolioWebsite.header.action}
				/>

				<CaseStudySection
					title={portfolioWebsite.overview.title}
					id="overview"
				>
					{portfolioWebsite.overview.paragraphs.map((paragraph) => (
						<p class="case-study-text">
							{paragraph}
						</p>
					))}
				</CaseStudySection>

				<CaseStudyFigure
					src={portfolioHomepage}
					alt={portfolioWebsite.figures.homepage.alt}
					caption={portfolioWebsite.figures.homepage.caption}
				/>
			</div>
		</section>
	</main>
</Layout>