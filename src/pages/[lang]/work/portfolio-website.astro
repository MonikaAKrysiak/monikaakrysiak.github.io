---
import type { GetStaticPaths } from 'astro';
import type { Language } from '../../../i18n';
import { getPortfolioWebsite } from '../../../data/case-studies/portfolio-website';
import { formatTypography } from "../../../utils/typography";


import Layout from '../../../layouts/Layout.astro';

import BackLink from '../../../components/BackLink.astro';
import CaseStudyHeader from '../../../components/CaseStudyHeader.astro';
import CaseStudySection from '../../../components/CaseStudySection.astro';
import CaseStudyFigure from '../../../components/CaseStudyFigure.astro';

import portfolioHomepage from '../../../assets/case-studies/portfolio-homepage.png';

export const getStaticPaths = (() => {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'pl' } },
	];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;
const language = lang as Language;
const portfolioWebsite = getPortfolioWebsite(language);
---

<Layout lang={language}>
	<main>
		<section class="case-study section">
			<div class="container">
				<BackLink lang={language} />

				<CaseStudyHeader
					title={formatTypography(portfolioWebsite.header.title, language)}
					summary={formatTypography(portfolioWebsite.header.summary, language)}
					focusAreas={portfolioWebsite.header.focusAreas}
					action={portfolioWebsite.header.action}
				/>

				<CaseStudySection
					id="overview"
					title={formatTypography(portfolioWebsite.overview.title, language)}
				>
					{portfolioWebsite.overview.paragraphs.map((paragraph) => (
						<p class="case-study-text">
							{formatTypography(paragraph, language)}
						</p>
					))}
				</CaseStudySection>

				<CaseStudyFigure
					src={portfolioHomepage}
					alt={portfolioWebsite.figures.homepage.alt}
					caption={portfolioWebsite.figures.homepage.caption}
				/>

				<CaseStudySection
					id="engineering-principles"
					title={formatTypography(
						portfolioWebsite.engineeringPrinciples.title,
						language
					)}
				>
					<p class="case-study-text">
						{formatTypography(
							portfolioWebsite.engineeringPrinciples.introduction,
							language
						)}
					</p>

					{portfolioWebsite.engineeringPrinciples.items.map((item) => (
						<article class="case-study-decision">
							<h3 class="case-study-decision-title">
								{formatTypography(item.title, language)}
							</h3>

							{item.paragraphs.map((paragraph) => (
								<p class="case-study-text">
									{formatTypography(paragraph, language)}
								</p>
							))}
						</article>
					))}
				</CaseStudySection>
			</div>
		</section>
	</main>
</Layout>