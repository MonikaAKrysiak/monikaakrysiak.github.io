---
import type { GetStaticPaths } from "astro";
import type { Language } from "../../../i18n";
import { getSecurityKnowledgeBase } from "../../../data/case-studies/security-knowledge-base";
import { getAdjacentWork } from "../../../data/work";
import { formatTypography } from "../../../utils/typography";

import Layout from "../../../layouts/Layout.astro";
import CaseStudyHeader from "../../../components/CaseStudyHeader.astro";
import CaseStudySection from "../../../components/CaseStudySection.astro";
import BackLink from "../../../components/BackLink.astro";
import CaseStudyNavigation from "../../../components/CaseStudyNavigation.astro";

export const getStaticPaths = (() => {
	return [
		{ params: { lang: "en" } },
		{ params: { lang: "pl" } },
	];
}) satisfies GetStaticPaths;

const { lang } = Astro.params;

const language = lang as Language;
const securityKnowledgeBase = getSecurityKnowledgeBase(language);

const { previous, next } = getAdjacentWork(
	language,
	"/work/security-knowledge-base",
);
---

<Layout lang={language}>
	<main>
		<section id="case-study-start" class="case-study section">
			<div class="container">
				<BackLink lang={language} />

				<CaseStudyHeader
					title={formatTypography(securityKnowledgeBase.header.title, language)}
					summary={formatTypography(securityKnowledgeBase.header.summary, language)}
					focusAreas={securityKnowledgeBase.header.focusAreas}
				/>

				<CaseStudySection
					id="overview"
					title={formatTypography(securityKnowledgeBase.overview.title, language)}
				>
					{securityKnowledgeBase.overview.paragraphs.map((paragraph) => (
						<p class="case-study-text">
							{formatTypography(paragraph, language)}
						</p>
					))}
				</CaseStudySection>
				<CaseStudyNavigation
					previous={
						previous
							? {
									href: `/${language}${previous.href}`,
									label: previous.title,
								}
							: undefined
					}
					next={
						next
							? {
									href: `/${language}${next.href}`,
									label: next.title,
								}
							: undefined
					}
					allWork={{
						href: `/${language}/#work`,
						label:
							language === "pl"
								? "Zobacz wszystkie projekty"
								: "View all selected work",
					}}
				/>
			</div>
		</section>
	</main>
</Layout>