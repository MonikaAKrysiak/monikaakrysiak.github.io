---
import type { GetStaticPaths } from "astro";

import SubpageLayout from "../../../layouts/SubpageLayout.astro";
import BackLink from "../../../components/BackLink.astro";
import HobbyPageHeader from "../../../components/HobbyPageHeader.astro";
import HobbyPageSection from "../../../components/HobbyPageSection.astro";
import HobbyPageNavigation from "../../../components/HobbyPageNavigation.astro";
import HobbyHighlights from "../../../components/HobbyHighlights.astro";
import HobbyQuote from "../../../components/HobbyQuote.astro";
import InteractiveFigure from "../../../components/InteractiveFigure.astro";

import {
	getTravel,
	getTravelNavigation,
} from "../../../data/hobby-pages/travel";
import {
	getTranslations,
	type Language,
} from "../../../i18n";

import TravelIcon from "../../../assets/icons/hobby-travel.svg";
import InstagramIcon from "../../../assets/icons/instagram.svg";
import StravaIcon from "../../../assets/icons/strava.svg";
import TravelHorsesImage from "../../../assets/hobbies/photography/travel-horses.jpg";
import TravelNiedzicaLakeImage from "../../../assets/hobbies/photography/travel-niedzica-lake-view.jpg";
import TravelOgrodzieniecCastleImage from "../../../assets/hobbies/photography/travel-ogrodzieniec-castle-view.jpg";
import TravelPieskowaSkalaImage from "../../../assets/hobbies/photography/travel-pieskowa-skala-view.jpg";
import TravelRanchEveningImage from "../../../assets/hobbies/photography/travel-ranch-evening.jpg";
import TravelTrzyKoronyImage from "../../../assets/hobbies/photography/travel-trzy-korony-panorama.jpg";

export const getStaticPaths: GetStaticPaths = () => {
	return [
		{
			params: { lang: "en" },
		},
		{
			params: { lang: "pl" },
		},
	];
};

const lang = Astro.params.lang as Language;
const travel = getTravel(lang);
const navigationItems = getTravelNavigation(lang);
const t = getTranslations(lang);

const travelGalleryImages = [
	{
		src: TravelOgrodzieniecCastleImage,
		...travel.galleryImages[0],
	},
	{
		src: TravelPieskowaSkalaImage,
		...travel.galleryImages[1],
	},
	{
		src: TravelNiedzicaLakeImage,
		...travel.galleryImages[2],
	},
	{
		src: TravelTrzyKoronyImage,
		...travel.galleryImages[3],
	},
	{
		src: TravelRanchEveningImage,
		...travel.galleryImages[4],
	},
	{
		src: TravelHorsesImage,
		...travel.galleryImages[5],
	},
];
---

<SubpageLayout
	lang={lang}
	navigationItems={navigationItems}
>
	<BackLink
		lang={lang}
		href={`/${lang}/#hobbies`}
		label={t.backLink.toHobbies}
	/>

	<HobbyPageHeader
		id="travel-about"
		title={travel.title}
		introduction={travel.introduction}
	/>

	<HobbyHighlights
		title={travel.highlightsTitle}
		items={travel.highlights.map((highlight) => ({
			...highlight,
			icon: TravelIcon,
		}))}
	/>

	<HobbyPageSection title={travel.originTitle}>
		<div class="travel-origin">
			{
				travel.originParagraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageSection
		id="travel-stories"
		title={travel.storiesTitle}
		introduction={travel.storiesIntroduction}
	>
		<div class="travel-stories">
			{
				travel.stories.map((story) => (
					<article class="travel-story">
						<div class="travel-story-heading">
							<p class="travel-story-year">
								{story.year}
							</p>

							<h3 class="travel-story-title">
								{story.title}
							</h3>

							<p class="travel-story-summary">
								{story.summary}
							</p>
						</div>

						<details class="travel-story-details">
							<summary class="travel-story-toggle">
								{t.hobbies.readFullStory}
							</summary>

							<div class="travel-story-content">
								{
									story.paragraphs.map((paragraph) => (
										<p>{paragraph}</p>
									))
								}
							</div>
						</details>
					</article>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyQuote quote={travel.quote} />

	<HobbyPageSection title={travel.lookingAheadTitle}>
		<div class="travel-plans">
			{
				travel.lookingAhead.map((item) => (
					<article class="travel-plan">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageSection
		id="travel-gallery"
		title={travel.galleryTitle}
		introduction={travel.galleryIntroduction}
	>
		<div
			class="travel-gallery"
			aria-label={travel.galleryTitle}
		>
			{
				travelGalleryImages.map((item) => (
					<InteractiveFigure
						lang={lang}
						src={item.src}
						alt={item.alt}
						className="travel-gallery-figure"
					/>
				))
			}

			<article class="travel-gallery-coming-soon">
				<div class="travel-gallery-coming-soon-content">
					<p class="travel-gallery-coming-soon-country">
						🇷🇴 Romania
					</p>

					<h3>
						{
							lang === "pl"
								? "Już wkrótce"
								: "Coming soon"
						}
					</h3>

					<p>
						{
							lang === "pl"
								? "Nasza pierwsza zagraniczna wyprawa."
								: "Our first adventure outside Poland."
						}
					</p>
				</div>
			</article>

			<article class="travel-gallery-coming-soon">
				<div class="travel-gallery-coming-soon-content">
					<p class="travel-gallery-coming-soon-country">
					</p>

					<h3>
						{
							lang === "pl"
								? "Nowe wspomnienia"
								: "New memories"
						}
					</h3>

					<p>
						{
							lang === "pl"
								? "To miejsce czeka na zdjęcia z Rumunii."
								: "This spot is waiting for photographs from Romania."
						}
					</p>
				</div>
			</article>
		</div>

		<div class="travel-external">
			<p class="travel-external-description">
				{
					lang === "pl"
						? "Więcej tras i zdjęć z naszych podróży publikuję na Stravie i Instagramie."
						: "I share more routes and photographs from our travels on Strava and Instagram."
				}
			</p>

			<div class="travel-external-links">
				<a
					class="travel-external-link"
					href="https://strava.app.link/wX5FIEE4n5b"
					target="_blank"
					rel="noopener noreferrer"
				>
					<StravaIcon aria-hidden="true" />
					<span>{travel.stravaLabel}</span>
				</a>

				<a
					class="travel-external-link"
					href="https://www.instagram.com/monika.a.krysiak?ighd=MW92bXF1eTEzZ3lmYw%3D%3D"
					target="_blank"
					rel="noopener noreferrer"
				>
					<InstagramIcon aria-hidden="true" />
					<span>{travel.instagramLabel}</span>
				</a>
			</div>
		</div>
	</HobbyPageSection>

	<HobbyPageNavigation
		lang={lang}
		previous={{
			label:
				lang === "pl"
					? "Fotografia"
					: "Photography",
			href: `/${lang}/hobbies/photography`,
		}}
		next={{
			label: "DIY",
			href: `/${lang}/hobbies/diy`,
		}}
		allHobbiesHref={`/${lang}/#hobbies`}
		allHobbiesLabel={
			lang === "pl"
				? "Zobacz wszystkie zainteresowania"
				: "View all hobbies"
		}
	/>
</SubpageLayout>

<style>
	.travel-origin {
		display: grid;
		gap: var(--space-md);
	}

	.travel-origin p {
		margin: 0;
		line-height: var(--line-height-body);
	}

	.travel-stories {
		display: grid;
		gap: var(--space-xl);
	}

	.travel-story {
		overflow: hidden;

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.travel-story-heading {
		padding: var(--space-lg);
	}

	.travel-story-year {
		margin: 0 0 var(--space-xs);

		color: var(--color-accent);
		font-weight: 700;
	}

	.travel-story-title {
		margin: 0 0 var(--space-sm);
	}

	.travel-story-summary {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.travel-story-details {
		border-top: 1px solid var(--color-border);
	}

	.travel-story-toggle {
		padding: var(--space-md) var(--space-lg);

		color: var(--color-accent);
		font-weight: 700;

		cursor: pointer;
	}

	.travel-story-toggle:hover {
		text-decoration: underline;
		text-underline-offset: 0.2rem;
	}

	.travel-story-toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -0.35rem;
	}

	.travel-story-content {
		display: grid;
		gap: var(--space-md);

		padding:
			0
			var(--space-lg)
			var(--space-lg);
	}

	.travel-story-content p {
		margin: 0;
		line-height: var(--line-height-body);
	}

	.travel-plans {
		display: grid;
		gap: var(--space-lg);
	}

	.travel-plan {
		padding: var(--space-lg);

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.travel-plan h3 {
		margin: 0 0 var(--space-sm);
	}

	.travel-plan p {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.travel-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm);
	}

	.travel-gallery :global(.interactive-figure) {
		height: 100%;
		margin: 0;
	}

	.travel-gallery :global(.interactive-figure-button) {
		display: block;

		width: 100%;
		height: 100%;
	}

	.travel-gallery :global(.interactive-figure-image) {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;

		object-fit: cover;

		border-radius: var(--space-sm);
	}

	.travel-external {
		margin-top: var(--space-2xl);
	}

	.travel-external-description {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.travel-external-links {
		display: grid;
		gap: var(--space-sm);

		margin-top: var(--space-sm);
	}

	.travel-external-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);

		width: fit-content;

		color: var(--color-primary);
		font-weight: 600;
		line-height: var(--line-height-body);
		text-decoration: none;

		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.travel-external-link:hover {
		color: var(--color-primary-hover);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.travel-external-link:focus-visible {
		color: var(--color-primary-hover);
	}

	.travel-external-link :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}

	.travel-gallery-coming-soon {
		min-width: 0;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;

		aspect-ratio: 4 / 3;
		width: 100%;

		padding: var(--space-xl);

		background:
			linear-gradient(
				135deg,
				var(--color-surface),
				color-mix(
					in srgb,
					var(--color-surface) 88%,
					var(--color-accent)
				)
			);

		border: 1px dashed var(--color-border);
		border-radius: var(--space-sm);

		box-sizing: border-box;
	}

	.travel-gallery-coming-soon-content {
		display: grid;
		gap: var(--space-sm);

		max-width: 18rem;

		text-align: center;
	}

	.travel-gallery-coming-soon-country {
		margin: 0;

		color: var(--color-accent);
		font-size: var(--font-size-body-small);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.03em;
		text-transform: uppercase;

		overflow-wrap: anywhere;
	}

	.travel-gallery-coming-soon-content {
		min-width: 0;
		width: 100%;
	}

	.travel-gallery-coming-soon h3 {
		margin: 0;
	}

	.travel-gallery-coming-soon p:last-child {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	@media (min-width: 48rem) {
		.travel-stories {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: start;
		}

		.travel-plans {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.travel-gallery {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.travel-external-links {
			grid-template-columns: repeat(2, max-content);
			align-items: center;
			column-gap: var(--space-2xl);
			row-gap: var(--space-sm);
		}
		.travel-gallery-coming-soon-country {
			letter-spacing: 0.08em;
		}
	}
</style>