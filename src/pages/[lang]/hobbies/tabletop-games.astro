---
import type { GetStaticPaths } from "astro";

import SubpageLayout from "../../../layouts/SubpageLayout.astro";
import BackLink from "../../../components/BackLink.astro";
import HobbyPageHeader from "../../../components/HobbyPageHeader.astro";
import HobbyPageSection from "../../../components/HobbyPageSection.astro";
import HobbyPageNavigation from "../../../components/HobbyPageNavigation.astro";
import HobbyHighlights from "../../../components/HobbyHighlights.astro";
import HobbyStoryCard from "../../../components/HobbyStoryCard.astro";
import HobbyQuote from "../../../components/HobbyQuote.astro";
import InteractiveFigure from "../../../components/InteractiveFigure.astro";

import { formatTypography } from "../../../utils/typography";
import {
	getGames,
	getTabletopGamesNavigation,
} from "../../../data/hobby-pages/tabletop-games";
import {
	getTranslations,
	type Language,
} from "../../../i18n";

import BookIcon from "../../../assets/icons/book.svg";
import PuzzleIcon from "../../../assets/icons/puzzle.svg";
import UsersIcon from "../../../assets/icons/users.svg";
import RpgDiceImage from "../../../assets/hobbies/tabletop-games/tabletop-games-rpg-dice.jpg";
import ZombieMiniaturesImage from "../../../assets/hobbies/tabletop-games/tabletop-games-painted-miniatures.jpg";
import LegoKingfisherImage from "../../../assets/hobbies/tabletop-games/tabletop-games-lego-kingfisher.jpg";
import ValentiaImage from "../../../assets/hobbies/tabletop-games/tabletop-games-Valentia.png";
import SophieChoicesImage from "../../../assets/hobbies/tabletop-games/tabletop-games-sophie-choices.png";

export const getStaticPaths: GetStaticPaths = () => {
	return [
		{
			params: { lang: "en" },
		},
		{
			params: { lang: "pl" },
		},
	];
};

const lang = Astro.params.lang as Language;
const games = getGames(lang);
const navigationItems = getTabletopGamesNavigation(lang);
const t = getTranslations(lang);

const tabletopHighlightIcons = {
    books: BookIcon,
    puzzles: PuzzleIcon,
    community: UsersIcon,
};

const storyImages = {
    rpgDice: RpgDiceImage,
    valentia: ValentiaImage,
    sophieChoices: SophieChoicesImage,
};
---
<SubpageLayout
	lang={lang}
	navigationItems={navigationItems}
>
	<BackLink
		lang={lang}
		href={`/${lang}/#hobbies`}
		label={t.backLink.toHobbies}
	/>

	<HobbyPageHeader
		id="tabletop-games-about"
		title={formatTypography(games.title, lang)}
		introduction={games.introduction.map((paragraph) =>
			formatTypography(paragraph, lang)
		)}
	/>

	<HobbyHighlights
		title={formatTypography(games.highlightsTitle, lang)}
		items={games.highlights.map((highlight) => {
    		const HighlightIcon = tabletopHighlightIcons[highlight.icon];

			if (!HighlightIcon) {
				return null;
			}

			return {
				...highlight,
				title: formatTypography(highlight.title, lang),
				description: formatTypography(highlight.description, lang),
				icon: HighlightIcon,
			};
		}).filter(Boolean)}
	/>

	<HobbyQuote
		title={formatTypography(games.whyRpgTitle, lang)}
		quote={formatTypography(games.whyRpg, lang)}
	/>

	<HobbyPageSection
		id="tabletop-games-stories"
		title={formatTypography(games.storiesTitle, lang)}
		introduction={formatTypography(games.storiesIntroduction, lang)}
	>
		<div class="tabletop-game-stories">
			{
				games.stories.map((story) => (
					<HobbyStoryCard
						title={formatTypography(story.title, lang)}
						summary={formatTypography(story.summary, lang)}
						paragraphs={story.paragraphs.map((paragraph) =>
							formatTypography(paragraph, lang)
						)}
						image={storyImages[story.imageKey]}
						imageAlt={story.imageAlt}
						imagePosition={story.imagePosition}
						imageFit={story.imageFit}
							readLabel={t.hobbies.readFullStory}
							hideLabel={t.hobbies.hideStory}
							detailsGroupName="tabletop-stories"
							/>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageSection
		id="tabletop-games-beyond-playing"
		title={formatTypography(games.beyondPlayingTitle, lang)}
	>
		<div class="beyond-playing-grid">
			{
				games.beyondPlaying.map((item, index) => (
					<article class="beyond-playing-card">
						<div class="beyond-playing-card-image-wrapper">
							<InteractiveFigure
								id={`tabletop-beyond-${index}`}
								lang={lang}
								src={
									index === 0
										? ZombieMiniaturesImage
										: LegoKingfisherImage
								}
								alt={item.title}
								className="beyond-playing-card-figure"
							/>
						</div>

						<div class="beyond-playing-card-content">
							<h3 class="beyond-playing-card-title">
								{formatTypography(item.title, lang)}
							</h3>

							<p class="beyond-playing-card-description">
								{formatTypography(item.description, lang)}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageNavigation
		lang={lang}
		previous={{
			label: "DIY",
			href: `/${lang}/hobbies/diy`,
		}}
		next={{
			label: t.hobbies.photography,
			href: `/${lang}/hobbies/photography`,
		}}
		allHobbiesHref={`/${lang}/#hobbies`}
		allHobbiesLabel={t.hobbies.viewAll}
	/>
</SubpageLayout>

<style>
	.tabletop-game-stories {
		display: grid;
		gap: var(--space-xl);
	}

	.beyond-playing-grid {
		display: grid;
		gap: var(--space-xl);
	}

	.beyond-playing-card {
		display: flex;
		flex-direction: column;

		padding: var(--space-lg);

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.beyond-playing-card-image-wrapper {
		display: flex;
		justify-content: center;
		align-items: center;

		overflow: hidden;
		height: 14rem;

		margin-bottom: var(--space-lg);
	}

	.beyond-playing-card-image-wrapper :global(.interactive-figure) {
		height: 100%;
		margin: 0;
	}

	.beyond-playing-card-image-wrapper :global(.interactive-figure-button) {
		display: flex;
		align-items: center;
		justify-content: center;

		width: 100%;
		height: 100%;
	}

	.beyond-playing-card-image-wrapper :global(.interactive-figure-image) {
		width: auto;
		max-width: 100%;

		height: 100%;

		object-fit: contain;

		border: none;
		border-radius: 0;
	}

	.beyond-playing-card-content {
		padding: 0;
	}

	.beyond-playing-card-title {
		margin: 0 0 var(--space-sm);
	}

	.beyond-playing-card-description {
		margin: 0;
		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	@media (min-width: 48rem) {
		.beyond-playing-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.beyond-playing-card-image-wrapper :global(.interactive-figure-image) {
			width: 95%;
			height: auto;
			max-height: 100%;
		}
	}
</style>
