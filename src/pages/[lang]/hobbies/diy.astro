---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";

import SubpageLayout from "../../../layouts/SubpageLayout.astro";

import BackLink from "../../../components/BackLink.astro";
import HobbyPageHeader from "../../../components/HobbyPageHeader.astro";
import HobbyPageNavigation from "../../../components/HobbyPageNavigation.astro";
import HobbyPageSection from "../../../components/HobbyPageSection.astro";
import HobbyQuote from "../../../components/HobbyQuote.astro";

import DiyIcon from "../../../assets/icons/hobby-diy.svg";
import HeartHandshakeIcon from "../../../assets/icons/heart-handshake.svg";
import NeedleThreadIcon from "../../../assets/icons/needle-thread.svg";
import PackageIcon from "../../../assets/icons/package.svg";
import PencilStarIcon from "../../../assets/icons/pencil-star.svg";

import DiyStanczykImage from "../../../assets/hobbies/diy/diy-stanczyk.jpg";
import DiyPillowsImage from "../../../assets/hobbies/diy/diy-pillows.jpg";
import DiyDevilImage from "../../../assets/hobbies/diy/diy-devil.jpg";

import {
	getDiy,
	getDiyNavigation,
} from "../../../data/hobby-pages/diy";

import {
	getTranslations,
	type Language,
} from "../../../i18n";

export const getStaticPaths: GetStaticPaths = () => {
	return [
		{
			params: { lang: "en" },
		},
		{
			params: { lang: "pl" },
		},
	];
};

const lang = Astro.params.lang as Language;

const diy = getDiy(lang);
const navigationItems = getDiyNavigation(lang);
const t = getTranslations(lang);

const diyHighlightIcons = [
	HeartHandshakeIcon,
	NeedleThreadIcon,
	PackageIcon,
	PencilStarIcon,
];

const diyStoryImages = [
	{
		src: DiyStanczykImage,
		alt:
			lang === "pl"
				? "Haft przedstawiający Stańczyka według obrazu Jana Matejki"
				: "Embroidery based on Jan Matejko's painting Stańczyk",
		position: "center",
	},
	{
		src: DiyPillowsImage,
		alt:
			lang === "pl"
				? "Haftowane poduszki z motywami zebry i żyrafy dla bliźniaczek"
				: "Embroidered pillows with zebra and giraffe motifs for twin girls",
		position: "center",
	},
	{
		src: DiyDevilImage,
		alt:
			lang === "pl"
				? "Diabełek wykonany z włóczki jako własnoręczny prezent"
				: "A yarn devil made as a handmade gift",
		position: "center",
	},
];
---

<SubpageLayout
	lang={lang}
	navigationItems={navigationItems}
>
	<BackLink
		lang={lang}
		href={`/${lang}/#hobbies`}
		label={t.backLink.toHobbies}
	/>

	<HobbyPageHeader
		id="diy-about"
		title={diy.title}
		introduction={diy.introduction}
	/>

	<section
		class="diy-highlights"
		aria-labelledby="diy-highlights-title"
	>
		<h2 id="diy-highlights-title">
			{diy.highlightsTitle}
		</h2>

		<div class="diy-highlights-grid">
			{
				diy.highlights.map((highlight, index) => {
					const HighlightIcon = diyHighlightIcons[index];

					return (
						<article class="diy-highlight">
							<div class="diy-highlight-title">
								<HighlightIcon aria-hidden="true" />

								<h3>{highlight.title}</h3>
							</div>

							<p>{highlight.description}</p>
						</article>
					);
				})
			}
		</div>
	</section>

	<HobbyPageSection title={diy.originTitle}>
		<div class="diy-origin">
			{
				diy.originParagraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageSection
		id="diy-stories"
		title={diy.storiesTitle}
		introduction={diy.storiesIntroduction}
	>
		<div class="diy-stories">
			{
				diy.stories.map((story, index) => {
					const storyImage = diyStoryImages[index];

					return (
						<article class="diy-story">
							<Image
								class="diy-story-image"
								src={storyImage.src}
								alt={storyImage.alt}
								width={640}
								height={420}
								style={`object-position: ${storyImage.position};`}
							/>

							<div class="diy-story-heading">
								<p class="diy-story-label">
									{story.label}
								</p>

								<h3 class="diy-story-title">
									{story.title}
								</h3>

								<p class="diy-story-summary">
									{story.summary}
								</p>
							</div>

							<details class="diy-story-details">
								<summary class="diy-story-toggle">
									<span>{t.hobbies.readFullStory}</span>

									<span
										class="diy-story-toggle-arrow"
										aria-hidden="true"
									>
										↓
									</span>
								</summary>

								<div class="diy-story-content">
									{
										story.paragraphs.map((paragraph) => (
											<p>{paragraph}</p>
										))
									}
								</div>
							</details>
						</article>
					);
				})
			}
		</div>
	</HobbyPageSection>

	<HobbyQuote quote={diy.quote} />

	<HobbyPageSection
		title={diy.lookingAheadTitle}
		introduction={diy.lookingAheadIntroduction}
	>
		<div class="diy-plans">
			{
				diy.lookingAhead.map((item) => (
					<article class="diy-plan">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageSection
		id="diy-gallery"
		title={diy.galleryTitle}
		introduction={diy.galleryIntroduction}
	>
		<div
			class="diy-gallery"
			aria-label={diy.galleryTitle}
		>
			{
				diy.galleryImages.map((image, index) => (
					<article class="diy-gallery-placeholder">
						<div class="diy-gallery-placeholder-content">
							<DiyIcon aria-hidden="true" />

							<p class="diy-gallery-placeholder-number">
								{String(index + 1).padStart(2, "0")}
							</p>

							<p>{image.alt}</p>
						</div>
					</article>
				))
			}
		</div>
	</HobbyPageSection>

	<HobbyPageNavigation
		lang={lang}
		previous={{
			label:
				lang === "pl"
					? "Podróże"
					: "Travel",
			href: `/${lang}/hobbies/travel`,
		}}
		next={{
			label:
				lang === "pl"
					? "Gry stołowe"
					: "Tabletop Games",
			href: `/${lang}/hobbies/tabletop-games`,
		}}
		allHobbiesHref={`/${lang}/#hobbies`}
		allHobbiesLabel={
			lang === "pl"
				? "Zobacz wszystkie zainteresowania"
				: "View all hobbies"
		}
	/>
</SubpageLayout>

<style>
	.diy-highlights {
		padding-block: var(--space-2xl);
	}

	.diy-highlights h2 {
		margin: 0 0 var(--space-xl);
	}

	.diy-highlights-grid {
		display: grid;
		gap: var(--space-md);
	}

	.diy-highlight {
		position: relative;
		overflow: hidden;

		padding: var(--space-lg);

		background:
			linear-gradient(
				145deg,
				color-mix(
					in srgb,
					var(--color-surface) 82%,
					var(--color-accent-diy)
				),
				var(--color-surface)
			);

		border: 1px solid
			color-mix(
				in srgb,
				var(--color-border) 70%,
				var(--color-accent-diy)
			);
		border-radius: var(--space-sm);
	}

	.diy-highlight::after {
		content: "";

		position: absolute;
		inset: auto 0 0 auto;

		width: 5rem;
		aspect-ratio: 1;

		background-color:
			color-mix(
				in srgb,
				var(--color-accent-diy) 12%,
				transparent
			);

		border-radius: 100% 0 0 0;
	}

	.diy-highlight-title {
		position: relative;
		z-index: 1;

		display: flex;
		align-items: center;
		gap: var(--space-sm);

		margin-bottom: var(--space-sm);
	}

	.diy-highlight-title :global(svg) {
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;

		color: var(--color-accent-diy);
	}

	.diy-highlight-title h3 {
		margin: 0;
	}

	.diy-highlight p {
		position: relative;
		z-index: 1;

		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.diy-origin {
		display: grid;
		gap: var(--space-md);
	}

	.diy-origin p {
		margin: 0;
		line-height: var(--line-height-body);
	}

	.diy-stories {
		display: grid;
		gap: var(--space-xl);
	}

	.diy-story {
		overflow: hidden;

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);

		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.diy-story:hover {
		border-color: var(--color-accent-diy);
	}

	.diy-story:has(.diy-story-details[open]) {
		background-color: var(--color-surface-hover);
		border-color: var(--color-accent-diy);
	}

	.diy-story-image {
		display: block;

		width: 100%;
		height: 14rem;

		object-fit: cover;

		border-bottom: 1px solid var(--color-border);
	}

	.diy-story-heading {
		padding: var(--space-lg);
	}

	.diy-story-label {
		margin: 0 0 var(--space-xs);

		color: var(--color-accent-diy);
		font-size: var(--font-size-body-small);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.diy-story-title {
		margin: 0 0 var(--space-sm);
	}

	.diy-story-summary {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.diy-story-details {
		border-top: 1px solid var(--color-border);
	}

	.diy-story-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);

		padding: var(--space-md) var(--space-lg);

		color: var(--color-accent-diy);
		font-weight: 700;

		cursor: pointer;
		user-select: none;
	}

	.diy-story-toggle::-webkit-details-marker {
		display: none;
	}

	.diy-story-toggle::marker {
		content: "";
	}

	.diy-story-toggle:hover {
		text-decoration: underline;
		text-underline-offset: 0.2rem;
	}

	.diy-story-toggle:focus-visible {
		outline: 2px solid var(--color-accent-diy);
		outline-offset: -0.35rem;
	}

	.diy-story-toggle-arrow {
		display: inline-block;

		transition: transform 0.2s ease;
	}

	.diy-story-details[open] .diy-story-toggle-arrow {
		transform: rotate(180deg);
	}

	.diy-story-content {
		display: grid;
		gap: var(--space-md);

		padding:
			0
			var(--space-lg)
			var(--space-lg);
	}

	.diy-story-content p {
		margin: 0;
		line-height: var(--line-height-body);
	}

	.diy-plans {
		display: grid;
		gap: var(--space-lg);
	}

	.diy-plan {
		padding: var(--space-lg);

		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--space-sm);
	}

	.diy-plan h3 {
		margin: 0 0 var(--space-sm);
	}

	.diy-plan p {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	.diy-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm);
	}

	.diy-gallery-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;

		min-width: 0;
		aspect-ratio: 4 / 3;
		padding: var(--space-lg);

		background:
			linear-gradient(
				135deg,
				var(--color-surface),
				color-mix(
					in srgb,
					var(--color-surface) 88%,
					var(--color-accent-diy)
				)
			);

		border: 1px dashed
			color-mix(
				in srgb,
				var(--color-border) 75%,
				var(--color-accent-diy)
			);
		border-radius: var(--space-sm);
	}

	.diy-gallery-placeholder-content {
		display: grid;
		justify-items: center;
		gap: var(--space-sm);

		max-width: 18rem;

		text-align: center;
	}

	.diy-gallery-placeholder-content :global(svg) {
		width: 2rem;
		height: 2rem;

		color: var(--color-accent-diy);
	}

	.diy-gallery-placeholder-number {
		margin: 0;

		color: var(--color-accent-diy);
		font-size: var(--font-size-body-small);
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.diy-gallery-placeholder-content p:last-child {
		margin: 0;

		color: var(--color-text-muted);
		line-height: var(--line-height-body);
	}

	@media (min-width: 48rem) {
		.diy-highlights-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.diy-stories {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: start;
		}

		.diy-plans {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.diy-gallery {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>