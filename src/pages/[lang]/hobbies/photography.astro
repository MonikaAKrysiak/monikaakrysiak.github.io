---
import type { GetStaticPaths } from "astro";

import SubpageLayout from "../../../layouts/SubpageLayout.astro";
import BackLink from "../../../components/BackLink.astro";
import HobbyPageHeader from "../../../components/HobbyPageHeader.astro";
import HobbyGallery from "../../../components/HobbyGallery.astro";
import HobbyPageNavigation from "../../../components/HobbyPageNavigation.astro";

import InstagramIcon from "../../../assets/icons/instagram.svg";

import { photographyImages } from "../../../data/hobby-pages/photography/images";
import {
	en,
	pl,
	getPhotographyNavigation,
} from "../../../data/hobby-pages/photography";
import {
	getTranslations,
	type Language,
} from "../../../i18n";

export const getStaticPaths: GetStaticPaths = () => {
	return [
		{
			params: { lang: "en" },
		},
		{
			params: { lang: "pl" },
		},
	];
};

const { lang } = Astro.params as {
	lang: Language;
};

const photography =
	lang === "pl"
		? pl
		: en;

const navigationItems = getPhotographyNavigation(lang);
const t = getTranslations(lang);
---

<SubpageLayout
	lang={lang}
	navigationItems={navigationItems}
>
	<BackLink
		lang={lang}
		href={`/${lang}/#hobbies`}
		label={t.backLink.toHobbies}
	/>

	<HobbyPageHeader
        id="photography-about"
        title={photography.title}
        introduction={photography.introduction}
    />

	<HobbyGallery
		id="photography-gallery"
		externalId="photography-external"
		lang={lang}
		title={
			lang === "pl"
				? "Wybrane fotografie"
				: "Selected photographs"
		}
		images={photographyImages}
		externalLink={photography.externalLink}
	>
		<InstagramIcon slot="icon" />
	</HobbyGallery>

	<HobbyPageNavigation
		lang={lang}
		previous={{
			label:
				lang === "pl"
					? "Gry stołowe"
					: "Tabletop Games",
			href: `/${lang}/hobbies/tabletop-games`,
		}}
		next={{
			label:
				lang === "pl"
					? "Podróże"
					: "Travel",
			href: `/${lang}/hobbies/travel`,
		}}
		allHobbiesHref={`/${lang}/#hobbies`}
		allHobbiesLabel={
			lang === "pl"
				? "Zobacz wszystkie zainteresowania"
				: "View all hobbies"
		}
	/>
</SubpageLayout>